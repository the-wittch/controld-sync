[settings]
# leave empty and set CONTROLD_API_TOKEN instead
api_token = ""
dry_run = true
cache_file = ".controld-sync-cache.json"
atomic_replace = true
fail_on_drift = false

[profiles]
names = ["Kids", "Adults"]

[folders]
"Badware Hoster" = "https://raw.githubusercontent.com/hagezi/dns-blocklists/c30a9937e79f18bb31dcf4d45ac4988c3ddc8e7a/controld/badware-hoster-folder.json"
"Most Abused TLDs" = "https://raw.githubusercontent.com/hagezi/dns-blocklists/c30a9937e79f18bb31dcf4d45ac4988c3ddc8e7a/controld/spam-tlds-combined-folder.json"
"Potentially Malicious IPs" = "https://raw.githubusercontent.com/yokoffing/Control-D-Config/0b9b90d4eeada5d9ca60c532e7ee6dcf8f9a967c/folders/potentially-malicious-ips.json"

# folders mapped to the same profile can't share hostnames
[profile_folders]
Kids = ["Badware Hoster", "Most Abused TLDs", "Potentially Malicious IPs"]
Adults = ["Badware Hoster", "Potentially Malicious IPs"]
